{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tp/accept",
  "title": "accept.json",
  "description": "Each acceptance criterion proven pass, fail or manual, with its evidence, against the live environment or a checkout. The three counts equal the criteria's results (checked as an invariant).",
  "type": "object",
  "required": ["where", "targets", "criteria", "passed", "failed", "manual"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "where": { "enum": ["live", "checkout"] },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repo", "env", "checkout"],
        "properties": {
          "repo": { "type": "string", "minLength": 1 },
          "env": { "anyOf": [ { "type": "null" }, { "$ref": "common.schema.json#/$defs/environment" } ] },
          "checkout": { "type": ["string", "null"] }
        }
      }
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["n", "text", "result", "evidence"],
        "properties": {
          "n": { "type": "integer", "minimum": 1 },
          "text": { "type": "string", "minLength": 1 },
          "result": { "enum": ["pass", "fail", "manual"] },
          "evidence": { "type": "string" }
        }
      }
    },
    "passed": { "type": "integer", "minimum": 0 },
    "failed": { "type": "integer", "minimum": 0 },
    "manual": { "type": "integer", "minimum": 0 }
  }
}

// PM2 process config — cluster mode with >=2 workers is required for
// `pm2 startOrReload`/`pm2 reload` to be zero-downtime (PM2 brings a new
// worker up, waits until it's ready, then kills an old one, one at a time).
// The instances/exec_mode placeholders below default to 2/'cluster' for
// that reason — only drop to 1/'fork' if memory is tight (e.g. a heavy SSR
// frontend on a t3.micro) and a brief connection drop on deploy is
// acceptable.
//
// The start-script/start-args placeholders below are asked for explicitly
// in Step 2b, not assumed — Next.js's `next start` is a common default
// suggestion when the repo looks like a Next.js app, but any Node-servable
// frontend (Nuxt, SvelteKit's node adapter, Remix, a custom server) works
// the same way as long as its production start command is known. See
// references/frontend-framework-support.md.
//
// `cwd` below resolves to the fixed `current` symlink, or a subdirectory
// of it for a monorepo (see Step 8's AppSubdirectory question), not
// __dirname — see the backend ecosystem template for why.
module.exports = {
  apps: [
    {
      name: '___APP_NAME___',
      cwd: '___APP_CWD___',
      script: '___FRONTEND_START_SCRIPT___',
      args: '___FRONTEND_START_ARGS___',
      instances: ___FRONTEND_INSTANCES___,
      exec_mode: '___FRONTEND_EXEC_MODE___',
      env: {
        NODE_ENV: 'production',
      },
    },
  ],
};
